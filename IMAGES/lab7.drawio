        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle Class Diagram - Hệ thống Quản lý Nhân sự Công ty Sơn Đông Á\nskinparam classAttributeIconSize 0\n\nclass PhongBan {\n  - maPhongBan: String {PK}\n  - tenPhongBan: String\n  - maTruongPhong: String {FK}\n  - moTa: String\n  + layDanhSachNhanVien(): List\n  + lapKeHoachPhanCong(): KeHoachPhanCong\n}\n\nclass NhanVien {\n  - maNV: String {PK}\n  - hoTen: String\n  - ngaySinh: Date\n  - gioiTinh: String\n  - diaChi: String\n  - soDienThoai: String\n  - email: String\n  - trangThai: String\n  - maPhongBan: String {FK}\n  + capNhatThongTin(): void\n  + xemLichSuQuyetDinh(): List\n  + xemBangLuongThang(): BangLuongThang\n}\n\nclass ChucVu {\n  - maChucVu: String {PK}\n  - tenChucVu: String\n  - phuCapMacDinh: double\n  + capNhatPhuCap(): void\n}\n\nclass QuyetDinhTuyendung {\n  - maQDThuViec: String {PK}\n  - soQuyetDinh: String\n  - maNV: String {FK}\n  - maPhongBan: String {FK}\n  - ngayKy: Date\n  - thoiGianThuViec: int\n  - luongThuViec: double\n  - dieuKhoan: String\n  + taoQDThuViec(): void\n  + inQuyetDinh(): void\n}\n\nclass HopDongLaoDong {\n  - maHopDong: String {PK}\n  - soHopDong: String\n  - maNV: String {FK}\n  - loaiHopDong: String\n  - ngayKy: Date\n  - ngayBatDau: Date\n  - ngayKetThuc: Date\n  - noiDungHD: String\n  + taoHopDong(): void\n  + giaHanHopDong(): void\n  + thanhLyHopDong(): void\n}\n\nclass HoSoBaoHiem {\n  - maBaoHiem: String {PK}\n  - maNV: String {FK}\n  - soBHXH: String\n  - soBHYT: String\n  - tyLeDongBHXH: double\n  - tyLeDongBHYT: double\n  - ngayCap: Date\n  + taoHoSoBaoHiem(): void\n  + tinhTienBaoHiem(): double\n}\n\nclass QuyetDinhLuong {\n  - maQDLuong: String {PK}\n  - soQuyetDinh: String\n  - maNV: String {FK}\n  - luongCoBan: double\n  - phuCapLuong: double\n  - phuCapDocHai: double\n  - ngayHieuLuc: Date\n  + taoQDLuong(): void\n  + dieuChinhLuong(): void\n}\n\nclass QuyetDinhChucVu {\n  - maQDChucVu: String {PK}\n  - soQuyetDinh: String\n  - maNV: String {FK}\n  - maChucVu: String {FK}\n  - phuCapChucVu: double\n  - ngayHieuLuc: Date\n  + taoQDChucVu(): void\n}\n\nclass KeHoachPhanCong {\n  - maKeHoach: String {PK}\n  - maPhongBan: String {FK}\n  - tuNgay: Date\n  - denNgay: Date\n  - nguoiLap: String\n  + taoKeHoach(): void\n  + guiBanChamCong(): void\n}\n\nclass ChiTietPhanCong {\n  - maCTPhanCong: String {PK}\n  - maKeHoach: String {FK}\n  - maNV: String {FK}\n  - ngayLamViec: Date\n  - caLamViec: String\n  + capNhatCaLam(): void\n}\n\nclass PhieuChamCong {\n  - maPhieuChamCong: String {PK}\n  - thangNam: String\n  - maNV: String {FK}\n  - soNgayCongThucTe: double\n  - soNgayNghiPhep: double\n  - soNgayNghiKhongPhep: double\n  + ghiNhanChamCong(): void\n  + tinhTongNgayCong(): double\n}\n\nclass PhieuPhuTroi {\n  - maPhieuPhuTroi: String {PK}\n  - soPhieu: String\n  - maPhongBan: String {FK}\n  - ngayLap: Date\n  - nguoiLap: String\n  + taoPhieuPhuTroi(): void\n  + duyetPhuTroi(): void\n}\n\nclass ChiTietPhuTroi {\n  - maCTPhuTroi: String {PK}\n  - maPhieuPhuTroi: String {FK}\n  - maNV: String {FK}\n  - ngayPhuTroi: Date\n  - soGioPhuTroi: double\n  - hinhThucPhuTroi: String\n  - heSoLuong: double\n  + tinhGioPhuTroiQuyDoi(): double\n}\n\nclass BangLuongThang {\n  - maBangLuong: String {PK}\n  - thangNam: String\n  - maNV: String {FK}\n  - luongCoBan: double\n  - tienLuongCongThucTe: double\n  - tienPhuTroi: double\n  - tienPhuCap: double\n  - tienKhenThuong: double\n  - tienKhauTruKyLuat: double\n  - tienKhauTruBaoHiem: double\n  - luongThucNhan: double\n  + tinhLuongThucNhan(): double\n  + xuatPhieuLuong(): void\n}\n\nclass QuyetDinhKTKL {\n  - maQDKTKL: String {PK}\n  - soQuyetDinh: String\n  - loaiQuyetDinh: String\n  - doiTuong: String\n  - maNV: String {FK}\n  - maPhongBan: String {FK}\n  - ngayKy: Date\n  - soTien: double\n  - lyDo: String\n  + taoQuyetDinh(): void\n  + duyetQuyetDinh(): void\n}\n\nclass PhieuThuChiKTKL {\n  - maPhieuTC: String {PK}\n  - soPhieu: String\n  - maQDKTKL: String {FK}\n  - loaiPhieu: String\n  - soTien: double\n  - ngayLap: Date\n  - hinhThucGiaoDich: String\n  + taoPhieuTC(): void\n  + inPhieuTC(): void\n}\n\n&#39; Relationships\nPhongBan \&quot;1\&quot; -- \&quot;0..*\&quot; NhanVien\nPhongBan \&quot;1\&quot; -- \&quot;0..1\&quot; NhanVien : TruongPhong\nNhanVien \&quot;1\&quot; -- \&quot;1..*\&quot; QuyetDinhTuyendung\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; HopDongLaoDong\nNhanVien \&quot;1\&quot; -- \&quot;0..1\&quot; HoSoBaoHiem\nNhanVien \&quot;1\&quot; -- \&quot;1..*\&quot; QuyetDinhLuong\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; QuyetDinhChucVu\nChucVu \&quot;1\&quot; -- \&quot;0..*\&quot; QuyetDinhChucVu\n\nPhongBan \&quot;1\&quot; o-- \&quot;0..*\&quot; KeHoachPhanCong\nKeHoachPhanCong \&quot;1\&quot; *-- \&quot;1..*\&quot; ChiTietPhanCong\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; ChiTietPhanCong\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuChamCong\n\nPhongBan \&quot;1\&quot; o-- \&quot;0..*\&quot; PhieuPhuTroi\nPhieuPhuTroi \&quot;1\&quot; *-- \&quot;1..*\&quot; ChiTietPhuTroi\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; ChiTietPhuTroi\n\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; BangLuongThang\nNhanVien \&quot;0..1\&quot; -- \&quot;0..*\&quot; QuyetDinhKTKL\nPhongBan \&quot;0..1\&quot; -- \&quot;0..*\&quot; QuyetDinhKTKL\nQuyetDinhKTKL \&quot;1\&quot; *-- \&quot;0..1\&quot; PhieuThuChiKTKL\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="ESmZZE0Jb0AQFP7eU47h-1">
