  <diagram id="gOd9nrQdAZ18cvQ1F49f" name="Trang-5">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle Class Diagram - Hệ thống Quản lý Tour Du lịch\nskinparam classAttributeIconSize 0\n\nclass Tour {\n  - maTour: String\n  - tenTour: String\n  - soNgay: int\n  - soDem: int\n  - donGia: double\n  + taoTour()\n  + capNhatTour()\n  + tinhChiPhi()\n  + layThongTinTour()\n}\n\nclass NoiDungChan {\n  - maDungChan: String\n  - thuTuDung: int\n  - coDoiPhuongTien: boolean\n  - coNoiAn: boolean\n  - coKhachSan: boolean\n  - loaiKhachSan: int\n  + capNhatThongTin()\n  + layThongTinDungChan()\n}\n\nclass DiemThamQuan {\n  - maDiemThamQuan: String\n  - tenDiemThamQuan: String\n  - diaDiem: String\n  - noiDung: String\n  - yNghia: String\n  + themDiemThamQuan()\n  + layThongTin()\n}\n\nclass PhuongTien {\n  - maPhuongTien: String\n  - tenPhuongTien: String\n  + layThongTinPhuongTien()\n}\n\nclass KhachHang {\n  - maKhachHang: String\n  - hoTenNguoiDaiDien: String\n  - soDienThoai: String\n  - diaChi: String\n  + dangKyTour()\n  + thanhToan()\n}\n\nclass KhachDoan {\n  - maKhachDoan: String\n  - tenCoQuanGiaDinh: String\n  - diaChiCoQuan: String\n  - soDienThoaiCoQuan: String\n  - soNguoiDi: int\n  - diaDiemDonYeuCau: String\n  - ngayDiChon: Date\n  - coBaoHiem: boolean\n  + lapPhieuDangKyDoan()\n  + datCoc()\n  + nopDanhSachBaoHiem()\n  + thanhToanQuyetToan()\n}\n\nclass KhachLe {\n  - maKhachLe: String\n  - soNguoi: int\n  - diemBanVe: String\n  + muaVeChuyen()\n  + thanhToanTienVe()\n}\n\nclass ChuyenDi {\n  - maChuyenDi: String\n  - ngayDi: Date\n  - ngayVe: Date\n  - soChoToiDa: int\n  - soChoConLai: int\n  + kiemTraChoTrong()\n  + capNhatCho()\n}\n\nclass PhieuDangKyDoan {\n  - maPhieuDoan: String\n  - ngayLap: Date\n  - tienCoc: double\n  - tongTien: double\n  - trangThaiThanhToan: String\n  + taoPhieu()\n  + xacNhanCoc()\n  + thanhToanKhauTru()\n}\n\nclass VeTour {\n  - maVe: String\n  - ngayIn: Date\n  - giaVe: double\n  - diaDiemDonQuyDinh: String\n  + inVe()\n  + xacNhanThanhToan()\n}\n\nclass DanhSachBaoHiem {\n  - maDanhSach: String\n  - soLuong: int\n  + themNguoiDiCung()\n  + xuatDanhSach()\n}\n\nclass NguoiDiCung {\n  - maNguoiDiCung: String\n  - hoTen: String\n  - ngaySinh: Date\n  - cccd: String\n  + layThongTin()\n}\n\nclass NhanVienHDV {\n  - maHDV: String\n  - hoTen: String\n  - soDienThoai: String\n  - luongCanBan: double\n  + kiemTraLichRanh()\n  + tinhLuongThang()\n}\n\nclass PhanCongHDV {\n  - maPhanCong: String\n  - ngayBatDau: Date\n  - ngayKetThuc: Date\n  - thuLaoTour: double\n  + phanCong()\n  + kiemTraTrungLich()\n}\n\nclass PhieuKhaoSat {\n  - maPhieuKS: String\n  - ngayGui: Date\n  - noiDungGopY: String\n  - mucDoHaiLong: int\n  + guiPhieuKhaoSat()\n  + ghiNhanGopY()\n}\n\nKhachHang &lt;|-- KhachDoan\nKhachHang &lt;|-- KhachLe\n\nTour \&quot;1\&quot; -- \&quot;0..*\&quot; NoiDungChan\nTour \&quot;1\&quot; -- \&quot;0..*\&quot; DiemThamQuan\nTour \&quot;1\&quot; -- \&quot;0..*\&quot; PhuongTien\nTour \&quot;1\&quot; -- \&quot;0..*\&quot; ChuyenDi\n\nKhachDoan \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuDangKyDoan\nKhachLe \&quot;1\&quot; -- \&quot;0..*\&quot; VeTour\n\nPhieuDangKyDoan \&quot;1\&quot; -- \&quot;0..1\&quot; DanhSachBaoHiem\nDanhSachBaoHiem \&quot;1\&quot; -- \&quot;1..*\&quot; NguoiDiCung\n\nNhanVienHDV \&quot;1\&quot; -- \&quot;0..*\&quot; PhanCongHDV\nChuyenDi \&quot;1\&quot; -- \&quot;0..*\&quot; PhanCongHDV\nPhieuDangKyDoan \&quot;1\&quot; -- \&quot;0..*\&quot; PhanCongHDV\n\nKhachHang \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuKhaoSat\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="MOYODhZvAJwZ0VTJTmLI-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
