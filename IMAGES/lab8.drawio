  <diagram id="n20CRHaqCxvsS4JE0rIy" name="Trang-5">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle Sequence Diagram - Lập Phiếu ghi nợ (UC06)\n\nactor \&quot;NV Bán hàng\&quot; as NV\nboundary \&quot;FormPhieuGhiNo\&quot; as Form\ncontrol \&quot;PhieuGhiNoService\&quot; as Service\nentity \&quot;KhachHang\&quot; as KH\nentity \&quot;HoaDon\&quot; as HD\nentity \&quot;PhieuGhiNo\&quot; as PGN\ndatabase \&quot;SQL Server DB\&quot; as DB\n\nNV -&gt; Form: 1. MoFormLapPhieuNo(maHD)\nForm -&gt; Service: 2. layThongTinHoaDon(maHD)\nService -&gt; HD: 3. getHoaDon(maHD)\nHD --&gt; Service: 4. thongTinHoaDon\nService --&gt; Form: 5. hienThiThongTin(HD)\n\nNV -&gt; Form: 6. NhapNgayHenTra, SoTienNo, LyDoNo\nNV -&gt; Form: 7. Click \&quot;Lưu Phiếu Ghi Nợ\&quot;\nForm -&gt; Service: 8. taoPhieuGhiNo(maHD, maKH, soTienNo, ngayHenTra, lyDoNo)\nService -&gt; KH: 9. kiemTraKhachQuen(maKH)\nKH --&gt; Service: 10. isKhachQuen = true\n\nalt Khách hàng là Khách quen\n    Service -&gt; PGN: 11. create(maPhieuNo, maHD, maKH, soTienNo, ngayHenTra, lyDoNo)\n    PGN --&gt; Service: 12. doiTuongPGN\n    Service -&gt; HD: 13. capNhatTrangThai(\&quot;Ghi nợ\&quot;)\n    HD --&gt; Service: 14. ok\n    Service -&gt; DB: 15. INSERT INTO PhieuGhiNo &amp; UPDATE HoaDon (Transaction)\n    DB --&gt; Service: 16. Transaction Committed Success\n    Service --&gt; Form: 17. Thông báo \&quot;Lập phiếu ghi nợ thành công\&quot;\n    Form --&gt; NV: 18. Hiển thị thông báo &amp; In phiếu nợ\nelse Không phải Khách quen\n    Service --&gt; Form: 19. Báo lỗi \&quot;Khách vãng lai không được phép ghi nợ\&quot;\n    Form --&gt; NV: 20. Hiển thị thông báo lỗi\nend\n@endl&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="3uO2UPE1cgy34YJipX5q-1">
