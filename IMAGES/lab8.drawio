        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nleft to right direction\n\nactor \&quot;Khách hàng\&quot; as KH\nactor \&quot;Nhân viên Bán hàng\&quot; as NVBH\nactor \&quot;Nhân viên Kho\&quot; as NVKho\n\nrectangle \&quot;Phân hệ Bán hàng &amp; Giao hàng đầy đủ\&quot; {\n    usecase \&quot;UC04: Đặt mua NGK &amp; Bán hàng\&quot; as UC04\n    usecase \&quot;UC04.1: Kiểm tra tồn kho NGK\&quot; as UC04_1\n    usecase \&quot;UC04.2: Lập Hóa đơn &amp; Giao ngay\&quot; as UC04_2\n    usecase \&quot;UC05.1: Thực hiện giao hàng theo đợt hẹn\&quot; as UC05_1\n    usecase \&quot;UC05: Lập Phiếu hẹn giao nhiều đợt\&quot; as UC05\n    usecase \&quot;UC06: Lập Phiếu ghi nợ (Cho Khách quen)\&quot; as UC06\n}\n\nKH --&gt; UC04\nNVBH --&gt; UC04\nNVKho --&gt; UC05_1\n\nUC04 .&gt; UC04_1 : &lt;&lt;include&gt;&gt;\nUC04_1 .&gt; UC04_2 : &lt;&lt;include&gt;&gt;\nUC04_2 .&gt; UC05_1 : &lt;&lt;include&gt;&gt;\nUC05_1 .&gt; UC05 : &lt;&lt;include&gt;&gt;\nUC06 .&gt; UC05 : &lt;&lt;extend&gt;&gt;\\n(Nếu Khách quen trả chậm)\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="PhEhOqYet5p0kGlmPgPl-1">
