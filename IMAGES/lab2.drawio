  <diagram id="la0J-7Rom3GiTEhMnQIb" name="Trang-13">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle Sequence Diagram - Đăng ký\n\nactor \&quot;Độc giả / Thủ thư\&quot; as User\nparticipant \&quot;FrmDangKy\&quot; as Frm\nparticipant \&quot;TaiKhoanService\&quot; as Service\ndatabase \&quot;SQL Server\&quot; as DB\n\nUser -&gt; Frm: Nhập tên đăng nhập, mật khẩu, mã bảo mật/mã quyền hạn\nFrm -&gt; Service: DangKy(username, password, maBaoMat, quyenHan)\nService -&gt; DB: SELECT * FROM TaiKhoan WHERE Username = @username\nDB --&gt; Service: Kết quả kiểm tra\n\nalt Tài khoản đã tồn tại\n    Service --&gt; Frm: KetQua: \&quot;Tài khoản đã tồn tại\&quot;\n    Frm --&gt; User: MessageBox: \&quot;Tài khoản đã tồn tại\&quot;\nelse Tài khoản chưa tồn tại\n    Service -&gt; Service: KiemTraMaBaoMat(maBaoMat)\n    alt Mã bảo mật không hợp lệ\n        Service --&gt; Frm: KetQua: \&quot;Mã bảo mật không hợp lệ\&quot;\n        Frm --&gt; User: MessageBox: \&quot;Mã bảo mật không hợp lệ\&quot;\n    else Mã bảo mật đúng / Không có\n        Service -&gt; DB: INSERT INTO TaiKhoan(...)\n        DB --&gt; Service: Lưu thành công\n        Service --&gt; Frm: KetQuaXuly: Ok (Cấp quyền)\n        Frm --&gt; User: Chuyển hướng giao diện thành công\n    end\nend\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="h3sysMrRqWB00jwRZqiA-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
