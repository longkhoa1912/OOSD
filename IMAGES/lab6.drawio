        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle Class Diagram - Hệ thống Quản lý Hồ sơ Bệnh án Bệnh viện\nskinparam classAttributeIconSize 0\n\nclass BenhNhan {\n  - maBenhNhan: String {PK}\n  - hoTen: String\n  - ngaySinh: Date\n  - diaChi: String\n  - soDienThoai: String\n  - anh3x4: String\n  + dangKyThongTin(): void\n  + capNhatThongTin(): void\n  + xemLichSuKham(): List&lt;PhieuKhamBenh&gt;\n}\n\nclass PhieuDangKy {\n  - maPhieuDK: String {PK}\n  - ngayLap: Date\n  - hoTen: String\n  - diaChi: String\n  - ngaySinh: Date\n  - soDienThoai: String\n  - anh3x4: String\n  - trangThai: String\n  + taoPhieuDK(): void\n  + xacNhanThongTin(): boolean\n}\n\nclass HoSoBenhAn {\n  - maHoSo: String {PK}\n  - ngayTao: Date\n  - maBenhNhan: String {FK}\n  - hanThuPhi: Date\n  - trangThai: String\n  + taoHoSo(): void\n  + traCuuHoSo(): HoSoBenhAn\n  + giaHanLePhi(): void\n}\n\nclass PhieuKhamBenh {\n  - maPhieuKham: String {PK}\n  - maHoSo: String {FK}\n  - ngayGioKham: DateTime\n  - maBacSi: String {FK}\n  - maKhoa: String {FK}\n  - trieuChung: String\n  - chanDoan: String\n  - loaiKham: String\n  + taoPhieuKham(): void\n  + ghiNhanTrieuChung(): void\n  + capNhatChanDoan(): void\n}\n\nclass BacSi {\n  - maBacSi: String {PK}\n  - hoTen: String\n  - chuyenKhoa: String\n  - soDienThoai: String\n  - maKhoa: String {FK}\n  + khamBenh(): void\n  + keToaThuoc(): ToaThuoc\n  + chiDinhXetNghiem(): PhieuXetNghiem\n  + xemLichSuBenhAn(): HoSoBenhAn\n}\n\nclass KhoaDieuTri {\n  - maKhoa: String {PK}\n  - tenKhoa: String\n  - moTa: String\n  + layDanhSachBacSi(): List&lt;BacSi&gt;\n}\n\nclass ToaThuoc {\n  - maToaThuoc: String {PK}\n  - maPhieuKham: String {FK}\n  - ngayKe: Date\n  - loiDangDung: String\n  + taoToaThuoc(): void\n  + inToaThuoc(): void\n}\n\nclass ChiTietToaThuoc {\n  - maChiTiet: String {PK}\n  - maToaThuoc: String {FK}\n  - maThuoc: String {FK}\n  - soLuong: int\n  - lieuDung: String\n  - cachDung: String\n  + tinhTienThuoc(): double\n}\n\nclass Thuoc {\n  - maThuoc: String {PK}\n  - tenThuoc: String\n  - donViTinh: String\n  - donGia: double\n  - tacDungPhu: String\n  + capNhatGia(): void\n}\n\nclass PhieuXetNghiem {\n  - maPhieuXN: String {PK}\n  - maPhieuKham: String {FK}\n  - tenXetNghiem: String\n  - ngayThucHien: DateTime\n  - ketQua: String\n  + taoPhieuXN(): void\n  + capNhatKetQua(): void\n}\n\nclass NhanVienCSKH {\n  - maNhanVien: String {PK}\n  - hoTen: String\n  - soDienThoai: String\n  + tiepNhanDangKy(): PhieuDangKy\n  + datCuocHen(): CuocHen\n  + ghiNhanGiaSuatVien(): void\n  + lapHoaDon(): HoaDon\n}\n\nclass CuocHen {\n  - maCuocHen: String {PK}\n  - maBenhNhan: String {FK}\n  - ngayGioHen: DateTime\n  - loaiHen: String\n  - trangThai: String\n  + taoCuocHen(): void\n  + huyCuocHen(): void\n}\n\nclass HoaDon {\n  - maHoaDon: String {PK}\n  - maBenhNhan: String {FK}\n  - loaiHoaDon: String\n  - ngayLap: Date\n  - tongTien: double\n  - trangThai: String\n  + tinhTongTien(): double\n  + inHoaDon(): void\n}\n\n&#39; Mối liên kết giữa các Class\nBenhNhan \&quot;1\&quot; -- \&quot;1..*\&quot; PhieuDangKy\nBenhNhan \&quot;1\&quot; -- \&quot;1\&quot; HoSoBenhAn\nBenhNhan \&quot;1\&quot; -- \&quot;0..*\&quot; CuocHen\nBenhNhan \&quot;1\&quot; -- \&quot;0..*\&quot; HoaDon\n\nNhanVienCSKH \&quot;1\&quot; -- \&quot;0..*\&quot; CuocHen\nNhanVienCSKH \&quot;1\&quot; -- \&quot;0..*\&quot; HoaDon\n\nHoSoBenhAn \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuKhamBenh\nBacSi \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuKhamBenh\nKhoaDieuTri \&quot;1\&quot; -- \&quot;0..*\&quot; BacSi\n\nPhieuKhamBenh \&quot;1\&quot; -- \&quot;0..1\&quot; ToaThuoc\nPhieuKhamBenh \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuXetNghiem\n\nToaThuoc \&quot;1\&quot; *-- \&quot;1..*\&quot; ChiTietToaThuoc\nChiTietToaThuoc \&quot;*\&quot; -- \&quot;1\&quot; Thuoc\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="nq19Esad0lwk91rd_tYp-1">
