        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n\nleft to right direction\n\nskinparam packageStyle rectangle\nskinparam actorStyle awesome\n\ntitle USE CASE DIAGRAM - CỔNG QUẢN LÝ THỰC TẬP VÀ ĐÁNH GIÁ DOANH NGHIỆP\n\nactor \&quot;Sinh viên\&quot; as SV\nactor \&quot;Doanh nghiệp\&quot; as DN\nactor \&quot;Giảng viên\&quot; as GV\nactor \&quot;Quản trị viên\&quot; as AD\n\nrectangle \&quot;CỔNG QUẢN LÝ THỰC TẬP VÀ ĐÁNH GIÁ DOANH NGHIỆP\&quot; {\n\n    package \&quot;Use Case dùng chung\&quot; {\n\n        usecase \&quot;UC01\\nĐăng nhập\&quot; as UC01\n        usecase \&quot;UC02\\nĐăng ký\&quot; as UC02\n    }\n\n    package \&quot;Use Case Sinh viên\&quot; {\n\n        usecase \&quot;UC03\\nQuản lý hồ sơ cá nhân\&quot; as UC03\n        usecase \&quot;UC04\\nTìm kiếm doanh nghiệp\&quot; as UC04\n        usecase \&quot;UC05\\nXem vị trí thực tập\&quot; as UC05\n        usecase \&quot;UC06\\nĐăng ký thực tập\&quot; as UC06\n        usecase \&quot;UC07\\nTheo dõi đơn thực tập\&quot; as UC07\n        usecase \&quot;UC15\\nNộp nhật ký\&quot; as UC15\n        usecase \&quot;UC16\\nNộp báo cáo\&quot; as UC16\n        usecase \&quot;UC22\\nĐánh giá doanh nghiệp\&quot; as UC22\n    }\n\n    package \&quot;Use Case Doanh nghiệp\&quot; {\n\n        usecase \&quot;UC08\\nQuản lý vị trí thực tập\&quot; as UC08\n        usecase \&quot;UC09\\nXét duyệt sinh viên\&quot; as UC09\n        usecase \&quot;UC10\\nTheo dõi sinh viên\&quot; as UC10\n        usecase \&quot;UC11\\nĐánh giá sinh viên\&quot; as UC11\n    }\n\n    package \&quot;Use Case Giảng viên\&quot; {\n\n        usecase \&quot;UC12\\nQuản lý sinh viên hướng dẫn\&quot; as UC12\n        usecase \&quot;UC13\\nTheo dõi tiến độ\&quot; as UC13\n        usecase \&quot;UC14\\nĐánh giá báo cáo\&quot; as UC14\n    }\n\n    package \&quot;Use Case Quản trị viên\&quot; {\n\n        usecase \&quot;UC17\\nQuản lý tài khoản\&quot; as UC17\n        usecase \&quot;UC18\\nQuản lý doanh nghiệp\&quot; as UC18\n        usecase \&quot;UC19\\nQuản lý giảng viên\&quot; as UC19\n        usecase \&quot;UC20\\nQuản lý đợt thực tập\&quot; as UC20\n        usecase \&quot;UC21\\nThống kê\&quot; as UC21\n    }\n}\n\n&#39; =========================\n&#39; USE CASE DÙNG CHUNG\n&#39; =========================\n\nSV --&gt; UC01\nDN --&gt; UC01\nGV --&gt; UC01\nAD --&gt; UC01\n\nSV --&gt; UC02\nDN --&gt; UC02\nGV --&gt; UC02\n\n&#39; =========================\n&#39; SINH VIÊN\n&#39; =========================\n\nSV --&gt; UC03\nSV --&gt; UC04\nSV --&gt; UC05\nSV --&gt; UC06\nSV --&gt; UC07\nSV --&gt; UC15\nSV --&gt; UC16\nSV --&gt; UC22\n\n&#39; =========================\n&#39; DOANH NGHIỆP\n&#39; =========================\n\nDN --&gt; UC08\nDN --&gt; UC09\nDN --&gt; UC10\nDN --&gt; UC11\n\n&#39; =========================\n&#39; GIẢNG VIÊN\n&#39; =========================\n\nGV --&gt; UC12\nGV --&gt; UC13\nGV --&gt; UC14\n\n&#39; =========================\n&#39; QUẢN TRỊ VIÊN\n&#39; =========================\n\nAD --&gt; UC17\nAD --&gt; UC18\nAD --&gt; UC19\nAD --&gt; UC20\nAD --&gt; UC21\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="7OgzwIfyd9zkrZNM1Odg-66">
