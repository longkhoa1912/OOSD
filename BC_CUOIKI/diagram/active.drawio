        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle Activity Diagram - UC21 Thống kê\n\nstart\n\n:Quản trị viên chọn \&quot;Thống kê\&quot;;\n:Chọn loại thống kê;\n\nif (Thống kê sinh viên?) then (Có)\n    :Thống kê số lượng sinh viên;\nelse (Không)\n    if (Thống kê doanh nghiệp?) then (Có)\n        :Thống kê doanh nghiệp;\n    else (Không)\n        if (Thống kê thực tập?) then (Có)\n            :Thống kê tình hình thực tập;\n        else (Không)\n            :Thống kê kết quả thực tập;\n        endif\n    endif\nendif\n\n:Tổng hợp dữ liệu;\n:Hiển thị kết quả thống kê;\n\nif (Muốn xuất báo cáo?) then (Có)\n    :Xuất báo cáo;\nendif\n\nstop\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="v6KtV7vehu1j42jIBf7d-1">
