        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle Activity Diagram - UC17 Quản lý tài khoản\n\nstart\n\n:Quản trị viên chọn \&quot;Quản lý tài khoản\&quot;;\n:Hiển thị danh sách tài khoản;\n\nif (Thêm tài khoản?) then (Có)\n    :Nhập thông tin tài khoản;\n    :Kiểm tra dữ liệu;\n    :Tạo tài khoản;\n\nelse (Không)\n    if (Sửa tài khoản?) then (Có)\n        :Chọn tài khoản;\n        :Chỉnh sửa thông tin;\n        :Lưu thay đổi;\n\n    else (Không)\n        if (Khóa tài khoản?) then (Có)\n            :Chọn tài khoản;\n            :Khóa tài khoản;\n        else (Không)\n            :Mở khóa tài khoản;\n        endif\n    endif\nendif\n\n:Thông báo kết quả;\n\nstop\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="rG6mD1cuKBiPWybvyx5e-1">
