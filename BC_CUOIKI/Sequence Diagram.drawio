        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    TAI_KHOAN {\n        int MaTK PK\n        string TenDangNhap UK\n        string MatKhauHash\n        string VaiTro\n        boolean TrangThai\n    }\n\n    SINH_VIEN {\n        int MaSV PK\n        int MaTK FK,UK\n        string MaSoSinhVien UK\n        string HoTen\n        string Email\n        string SoDienThoai\n        string Lop\n        string Nganh\n    }\n\n    GIANG_VIEN {\n        int MaGV PK\n        int MaTK FK,UK\n        string MaSoGiangVien UK\n        string HoTen\n        string Email\n        string SoDienThoai\n        string BoMon\n    }\n\n    DOANH_NGHIEP {\n        int MaDN PK\n        int MaTK FK,UK\n        string TenDoanhNghiep\n        string MaSoThue\n        string DiaChi\n        string LinhVuc\n        string Email\n        string SoDienThoai\n    }\n\n    DOT_THUC_TAP {\n        int MaDot PK\n        string TenDot\n        date NgayBatDau\n        date NgayKetThuc\n        date HanDangKy\n        string TrangThai\n    }\n\n    VI_TRI_THUC_TAP {\n        int MaVT PK\n        int MaDN FK\n        int MaDot FK\n        string TenViTri\n        string MoTa\n        string YeuCau\n        int SoLuong\n        string DiaDiem\n        string TrangThai\n    }\n\n    DON_DANG_KY {\n        int MaDon PK\n        int MaSV FK\n        int MaVT FK\n        datetime NgayNop\n        string ThuGioiThieu\n        string TrangThai\n        string GhiChu\n    }\n\n    THUC_TAP {\n        int MaTT PK\n        int MaDon FK,UK\n        int MaGV FK\n        date NgayBatDau\n        date NgayKetThuc\n        string TrangThai\n    }\n\n    NHAT_KY {\n        int MaNK PK\n        int MaTT FK\n        date NgayGhi\n        string NoiDung\n        datetime NgayTao\n    }\n\n    BAO_CAO {\n        int MaBC PK\n        int MaTT FK\n        string TieuDe\n        string DuongDanTep\n        datetime NgayNop\n        decimal Diem\n        string NhanXet\n        string TrangThai\n    }\n\n    DANH_GIA_SINH_VIEN {\n        int MaDGSV PK\n        int MaTT FK,UK\n        decimal Diem\n        string NhanXet\n        datetime NgayDanhGia\n    }\n\n    DANH_GIA_DOANH_NGHIEP {\n        int MaDGDn PK\n        int MaTT FK,UK\n        int Diem\n        string NhanXet\n        datetime NgayDanhGia\n    }\n\n    TAI_KHOAN ||--o| SINH_VIEN : \&quot;có hồ sơ\&quot;\n    TAI_KHOAN ||--o| GIANG_VIEN : \&quot;có hồ sơ\&quot;\n    TAI_KHOAN ||--o| DOANH_NGHIEP : \&quot;có hồ sơ\&quot;\n\n    DOANH_NGHIEP ||--o{ VI_TRI_THUC_TAP : \&quot;đăng tuyển\&quot;\n    DOT_THUC_TAP ||--o{ VI_TRI_THUC_TAP : \&quot;bao gồm\&quot;\n\n    SINH_VIEN ||--o{ DON_DANG_KY : \&quot;gửi\&quot;\n    VI_TRI_THUC_TAP ||--o{ DON_DANG_KY : \&quot;nhận đơn\&quot;\n\n    DON_DANG_KY ||--o| THUC_TAP : \&quot;được duyệt thành\&quot;\n    GIANG_VIEN o|--o{ THUC_TAP : \&quot;hướng dẫn\&quot;\n\n    THUC_TAP ||--o{ NHAT_KY : \&quot;có\&quot;\n    THUC_TAP ||--o{ BAO_CAO : \&quot;có\&quot;\n    THUC_TAP ||--o| DANH_GIA_SINH_VIEN : \&quot;được đánh giá\&quot;\n    THUC_TAP ||--o| DANH_GIA_DOANH_NGHIEP : \&quot;được đánh giá\&quot;&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="ME-OU9LXeRJfOR5kFL_0-1">
